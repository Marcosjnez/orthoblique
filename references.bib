@inproceedings{tian_2021,
  title = {A {{Rotation Criterion That Encourages}} a {{Hierarchical Factor Structure}}},
  booktitle = {Quantitative {{Psychology}}},
  author = {Tian, Chen and Liu, Yang},
  editor = {Wiberg, Marie and Molenaar, Dylan and Gonz{\'a}lez, Jorge and B{\"o}ckenholt, Ulf and Kim, Jee-Seon},
  year = 2021,
  pages = {1--8},
  publisher = {Springer International Publishing},
  address = {Cham},
  doi = {10.1007/978-3-030-74772-5_1},
  abstract = {A hierarchical factor structure is frequently encountered in areas such as educational and psychological testing; however, there is no existing rotation criterion function that encourages hierarchical structures in the context of Exploratory Factor Analysis (EFA). The present study aims to fill in the gap by proposing a new rotation criterion that facilitates the recovery of multi-layer hierarchical structure. A simulation study was done to examine the performance of the new rotation criterion under conditions determined by three fully crossed factors: (a) the number of items, (b) the magnitude of error, and (c) equal/unequal numbers of manifest variables among sibling factors. Results show that the minimized criterion function values are close to 0 across all conditions, and that the proposed rotation criterion is able to recover the true factor loadings even in the presence of moderate departure from the exact hierarchical structure and unbalanced number of items per factor.},
  isbn = {978-3-030-74772-5},
  langid = {english},
  keywords = {Analytic rotation,Exploratory factor analysis,Hierarchical factor model,Riemannian optimization}
}

