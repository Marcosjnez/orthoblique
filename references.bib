@article{michell_1988,
  title = {Some Problems in Testing the Double Cancellation Condition in Conjoint Measurement},
  author = {Michell, Joel},
  year = 1988,
  month = dec,
  journal = {Journal of Mathematical Psychology},
  volume = {32},
  number = {4},
  pages = {466--473},
  issn = {0022-2496},
  doi = {10.1016/0022-2496(88)90024-7},
  urldate = {2019-11-17},
  abstract = {Two problems involved in testing the conjoint measurement condition of double cancellation are analysed. 1. It is argued that in the case of complete data matrices tests of double cancellation either confirm or falsify the hypothesis of additivity and that, contrary to popular belief, so-called ``no-tests'' are really acceptances. 2. It is shown that with a weak order upon 3 \texttimes{} 3 matrices both independence and a single test of double cancellation (which is logically independent of independence) are necessary and sufficient for additivity. Hence, if a weak order satisfies independence in such matrices only this single test of double cancellation needs to be performed.},
  langid = {english}
}

