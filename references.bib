@book{spence_1956,
  title = {Behavior Theory and Conditioning},
  author = {Spence, Kenneth W.},
  year = 1956,
  series = {Behavior Theory and Conditioning},
  publisher = {Yale University Press},
  address = {New Haven, CT, US},
  doi = {10.1037/10029-000},
  abstract = {This book presents empirical data from a number of simple conditioning situations and a theoretical structure or schema that has as its primary purpose the integration (derivation) of these data. The book attempts to show how the theory, developed on the basis of these simple conditioning experiments, may be extended to more complex types of behavior phenomena such as selective and paired-associate learning. In addition to these empirical and theoretical objectives emphasis has been placed on the discussion of some of the problems and issues that arise in connection with such theoretical formulations. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {Behaviorism,Conditioning,Theories}
}

