@techreport{uva_2020,
  title = {Unique Variable Analysis: {{A}} Network Psychometrics Method to Detect Local Dependence},
  shorttitle = {Unique Variable Analysis},
  author = {Christensen, Alexander and Garrido, Luis Eduardo and Golino, Hudson},
  year = 2020,
  month = dec,
  institution = {PsyArXiv},
  doi = {10.31234/osf.io/4kra2},
  urldate = {2022-09-01},
  abstract = {Local independence is the assumption that variables are unrelated after conditioning on a latent variable. This assumption underlies some of the most commonly used models in psychology: factor models and item response theory (IRT) models. Violations of the local independence assumption can lead to inaccurate estimates of internal structure, biased item parameters, and invalid scale scores. Although there are many statistics that are used in the factor analytic and IRT literature, they are relatively limited in contexts where the underlying internal structure of the data is unknown. These issues motivated the development of a novel network psychometrics method called Unique Variable Analysis (UVA), which detects locally dependent variables in multivariate, multidimensional data without the estimation of an internal structure. Using a Monte Carlo simulation approach, we generated multivariate multidimensional data with local dependencies (also referred to as correlated residuals in the factor analytic literature). We compared the Standard Expected Change Parameter (SEPC) in Exploratory Structural Equation Models, Jackknife Slope Index (JSI) in IRT, partial correlations, and UVA on their ability to correctly identify local dependence in multidimensional data. We found that SEPC and UVA outperformed the JSI and partial correlation methods and performed comparably across conditions. An automated UVA method is introduced and applied to real-world data, demonstrating its ability to resolve local dependence violations.},
  langid = {american}
}

@article{valenzuela_brain_2008,
  title = {Brain Reserve and the Prevention of Dementia},
  author = {Valenzuela, Michael J},
  year = 2008,
  journal = {Current Opinion in Psychiatry},
  volume = {21},
  number = {3},
  pages = {--},
  issn = {0951-7367},
  abstract = {Purpose of review To evaluate and synthesize recent evidence linking mental activity and dementia risk, which commonly invokes `brain reserve' as the mediating construct. Recent findings Brain reserve has acquired several interpretations; however, the most reliable and practical definition focuses at the behavioural level by assessing frequency and range of participation in complex mental activities. Epidemiological research suggests a clear and consistent link of high brain reserve with reduced dementia risk. Furthermore, emerging clinical trials of cognitive exercise suggest that it may be effective for the prevention of longitudinal cognitive and functional decline. Recent animal studies implicate several mechanisms, including disease-dependent and disease-independent compensatory pathways. Summary Given the precipitous forecasts for dementia over the coming decades, effective preventive strategies are of utmost importance. Findings from brain reserve studies now meet many of the formal criteria for causal agency between complex mental activity and reduced dementia risk. Key clinical trials are therefore under way to test these claims and results are keenly awaited.},
  keywords = {brain reserve,cognitive exercise,dementia,mental activities,prevention}
}

